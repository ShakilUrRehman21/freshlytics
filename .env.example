# ---------- Database ----------
# Option A: one connection string (Neon, Supabase, Render…). libpq params such as
# ?sslmode=require are handled automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Option B: individual values
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_db_password
POSTGRES_DB=freshlytics
POSTGRES_SERVER=localhost        # 'db' inside Docker Compose
# POSTGRES_SSL=auto              # auto = SSL for any non-local host (required by Neon)
#
# Option C: zero-setup local file database
# DATABASE_URL=sqlite+aiosqlite:///./freshlytics.db

# ---------- API ----------
SECRET_KEY=supersecretkey_please_change_in_production
# CORS_ORIGINS=http://localhost:3000

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000/api/v1
